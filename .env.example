# =============================================================================
# ppxai Environment Configuration
# =============================================================================
# This file contains API keys and environment settings.
# Copy to .env and add your actual API keys.
#
# Location search order:
#   1. ./.env (project directory)
#   2. ~/.ppxai/.env (user directory)
#
# IMPORTANT: Never commit your actual .env file to version control!
# =============================================================================

# =============================================================================
# PROVIDER API KEYS
# =============================================================================
# Add at least one provider API key to use ppxai.
# Uncomment and fill in the keys for providers you want to use.

# -----------------------------------------------------------------------------
# PERPLEXITY AI - BEST FOR WEB SEARCH
# -----------------------------------------------------------------------------
# Best for: Web search, research, up-to-date information, grounded responses
# Get key: https://www.perplexity.ai/settings/api
# Models: sonar (fast), sonar-pro (best), sonar-reasoning-pro, sonar-deep-research
# Pricing: https://docs.perplexity.ai/docs/pricing
#
# RECOMMENDED: sonar-pro
#   - Best Perplexity model for coding tasks (73.4% benchmark v1.15.3)
#   - Excellent for complex refactoring, multi-file changes, architecture
#   - Built-in web search for up-to-date information
#
# WARNING: sonar-reasoning-pro has poor tool calling (50%) - avoid for agentic tasks
#
# PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# GOOGLE GEMINI (Free tier available) - RECOMMENDED FOR CODE EDITING
# -----------------------------------------------------------------------------
# Best for: Multimodal (images), coding, general tasks
# Get key: https://aistudio.google.com/apikey
# Models: gemini-3-flash-preview (BEST - 100% quality), gemini-2.5-flash, gemini-2.5-pro
# Pricing: https://ai.google.dev/pricing (generous free tier)
#
# RECOMMENDED: gemini-3-flash-preview
#   - Achieved 100% code editing quality score (v1.15.3 benchmarks)
#   - Best model for agentic coding tasks with balanced AGENTS.md hints
#   - Excellent for refactoring, debugging, multi-file changes
#
# ALTERNATIVE: gemini-2.5-flash (71.4% quality with aggressive hints)
#   - Good performance but requires more restrictive prompt engineering
#
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OPENAI (ChatGPT)
# -----------------------------------------------------------------------------
# Best for: General chat, coding, reasoning
# Get key: https://platform.openai.com/api-keys
# Models: gpt-4o, gpt-4o-mini, o1, o1-mini
# Pricing: https://openai.com/pricing
#
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OPENROUTER (Multi-provider gateway)
# -----------------------------------------------------------------------------
# Best for: Access to Claude, Llama, Gemini, Mistral, and 100+ models via one API
# Get key: https://openrouter.ai/keys
# Models: anthropic/claude-sonnet-4, anthropic/claude-opus-4, meta-llama/llama-3.1-405b, etc.
# Pricing: https://openrouter.ai/models (pay-per-use)
#
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# LOCAL MODELS (vLLM, Ollama)
# -----------------------------------------------------------------------------
# For self-hosted models via vLLM or Ollama
# Set any value (API key is not validated for local endpoints)
#
# LOCAL_API_KEY=dummy
# OLLAMA_API_KEY=ollama
# VLLM_API_KEY=dummy
# LMSTUDIO_API_KEY=lm-studio

# =============================================================================
# PREMIUM WEB SEARCH (v1.13.4+)
# =============================================================================
# For providers without native web search (OpenAI, OpenRouter, local models),
# ppxai can use Perplexity or Gemini for web searches.
# Requires the corresponding API key above.
#
# Priority: Perplexity Sonar > Gemini Grounding > DuckDuckGo (free)
# Configure in ppxai-config.json under tools.web_search.preferred

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# -----------------------------------------------------------------------------
# Provider Selection
# -----------------------------------------------------------------------------
# Override the default provider from ppxai-config.json
# Values: perplexity, gemini, openai, openrouter, local-vllm, ollama
#
# DEFAULT_PROVIDER=perplexity

# -----------------------------------------------------------------------------
# TLS / SSL Configuration (Corporate Proxies)
# -----------------------------------------------------------------------------
# Behind a proxy that performs TLS inspection, point ppxai at the proxy's CA
# instead of turning verification off. The bundle is ADDED to the system trust
# store, never substituted for it, so the same setting keeps working on a
# direct connection — a laptop can roam between networks with no config edit.
#
# SSL_CERT_FILE=/path/to/corporate-ca.pem
#
# Often you need nothing at all: if IT installed the CA into the OS trust
# store (the usual route on Windows/macOS), ppxai picks it up automatically.
#
# Last resort — disables certificate checking for EVERY request, so traffic
# can be intercepted undetected. Prefer SSL_CERT_FILE above. ppxai logs a
# warning at startup and flags this in /doctor while it is set.
#
# SSL_VERIFY=false
#
# Both can also be set in ppxai-config.json under network.ssl
# ({"verify": true, "cert_file": "..."}); these environment variables win.

# -----------------------------------------------------------------------------
# Custom Config File Location
# -----------------------------------------------------------------------------
# Override the default config file search path:
#   1. ./ppxai-config.json (project-specific)
#   2. ~/.ppxai/ppxai-config.json (user-specific)
#   3. Built-in defaults
#
# PPXAI_CONFIG_FILE=/path/to/your/ppxai-config.json

# =============================================================================
# TERMINAL IMAGE DISPLAY (v1.15.2+)
# =============================================================================
# Override automatic terminal detection for users with multiple terminals.
# Useful when environment variables don't correctly identify your terminal.
#
# Run `/terminal` in ppxai to see detected vs configured values.
# See docs/INSTALLATION.md for detailed terminal configuration guide.
#
# TIP: For multi-terminal setups, set these variables in each terminal's config
# rather than here. This allows each terminal to use its optimal protocol.

# -----------------------------------------------------------------------------
# Force Terminal Identification
# -----------------------------------------------------------------------------
# Override automatic detection of terminal emulator.
# Values: WezTerm, iTerm.app, kitty, Windows Terminal, xterm, auto (default)
#
# Examples by platform:
#   macOS:   PPXAI_TERMINAL=iTerm.app  (or WezTerm, kitty)
#   Windows: PPXAI_TERMINAL=WezTerm    (or Windows Terminal)
#   Linux:   PPXAI_TERMINAL=kitty      (or WezTerm, xterm)
#
# PPXAI_TERMINAL=auto

# -----------------------------------------------------------------------------
# Force Image Protocol
# -----------------------------------------------------------------------------
# Override automatic image protocol detection.
# Values: iterm2, kitty, sixel, none, auto (default)
#
# Protocol support by terminal:
#   - iterm2: iTerm2 (macOS), WezTerm (all), mintty (Windows)
#   - kitty:  Kitty (macOS/Linux)
#   - sixel:  Windows Terminal, Konsole (Linux), xterm-sixel
#   - none:   Disable images (Terminal.app, legacy terminals)
#
# Platform recommendations:
#   macOS (iTerm2):        PPXAI_IMAGE_PROTOCOL=iterm2
#   macOS (WezTerm):       PPXAI_IMAGE_PROTOCOL=iterm2
#   macOS (Terminal.app):  PPXAI_IMAGE_PROTOCOL=none  (not supported)
#   Windows (WezTerm):     PPXAI_IMAGE_PROTOCOL=iterm2
#   Windows (WT):          PPXAI_IMAGE_PROTOCOL=sixel
#   Linux (Kitty):         PPXAI_IMAGE_PROTOCOL=kitty
#   Linux (WezTerm):       PPXAI_IMAGE_PROTOCOL=iterm2
#
# PPXAI_IMAGE_PROTOCOL=auto

# -----------------------------------------------------------------------------
# Configuration Best Practices
# -----------------------------------------------------------------------------
# RECOMMENDED: Configure per-terminal instead of using this file:
#
# macOS - iTerm2:
#   Preferences → Profiles → General → Environment
#   Add: PPXAI_TERMINAL=iTerm.app, PPXAI_IMAGE_PROTOCOL=iterm2
#
# macOS - WezTerm (~/.wezterm.lua):
#   config.set_environment_variables = {
#     TERM_PROGRAM = 'WezTerm',
#   }
#
# macOS - Shell Profile (~/.zshrc):
#   export PPXAI_TERMINAL=iTerm.app
#   export PPXAI_IMAGE_PROTOCOL=iterm2
#
# Windows - Terminal (settings.json):
#   "profiles": { "defaults": { "environment": {
#     "PPXAI_IMAGE_PROTOCOL": "sixel"
#   }}}
#
# Windows - WezTerm (%USERPROFILE%\.wezterm.lua):
#   config.set_environment_variables = {
#     TERM_PROGRAM = 'WezTerm',
#   }
#
# This approach allows switching terminals without editing this file.

# =============================================================================
# BACKWARD COMPATIBILITY (Deprecated)
# =============================================================================
# These CUSTOM_* variables are deprecated. Please use ppxai-config.json instead.
# They still work for backward compatibility with older setups.
#
# CUSTOM_MODEL_ENDPOINT=http://localhost:8000/v1
# CUSTOM_PROVIDER_NAME=My Self-Hosted LLM
# CUSTOM_MODEL_ID=my-model
# CUSTOM_MODEL_NAME=My Model
# CUSTOM_MODEL_DESC=Description of my model
# CUSTOM_API_KEY=your-api-key-here
