# Python virtual environment
venv/
env/
ENV/
.venv/

# Python compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!ppxai/web/lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
# Keep ppxai.spec for builds, but ignore auto-generated specs
!ppxai.spec

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# Environment variables (secrets)
**/.env
**/.env.local

# User-specific config (project-level config can be committed)
# ppxai-config.json  # Uncomment to ignore project-level config

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/*
!.claude/commands/
!.claude/skills/
CLAUDE.md
.ppxai/tools.config.json
tmpclaude-*-cwd
nul

# uv binary cache (downloaded by bootstrap.py)
.uv/

# GitHub token (for local release uploads)
.github/gh-tokenv.env
.github/gh-token.env
.github/hf-token.txt
tests/e2e/node_modules/
tests/e2e/playwright-report/
tests/e2e/test-results/

# Benchmark debug logs (regenerable with --debug flag)
benchmarks/llm-eval/debug/

# DGX user guide (contains IPs, usernames, passwords - deployed to /opt/hf/ on DGX)
docs/DGX-SPARK-USER-GUIDE.md

# Helm environment values (contain real IPs, hostnames, LDAP details)
deploy/helm/ppxai/values-microk8s.yaml

# Shared deployment configs (contain internal hostnames)
deploy/shared/ppxai-config.json
deploy/shared/ppxai-config-local.json

# MicroK8s raw manifests (contain real IPs, hostnames, LDAP details — replaced by Helm chart)
deploy/microk8s/
.mcp.json
docs/session-log-*.txt

# Graphify (https://github.com/safishamsi/graphify) — knowledge graph
# artifacts. Outputs and per-run scratch files. `.graphifyignore` is
# intentionally NOT ignored — it's a project-level input filter
# (equivalent to .gitignore for graphify) and meant to be committed.
graphify-out/
graphify-out-*/
graphify-out.bak.*/
.graphify_*

# MkDocs build output. Generated by `mkdocs build`; CI publishes to the
# gh-pages branch via .github/workflows/docs.yml. The site/ dir was
# historically tracked but committed-and-stale; removed in v1.18.7.
site/

# Build-time info (generated by scripts/write_build_info.py before
# each PyInstaller run; bundles real commit + mtime into the binary
# so the v1.18.2 banner doesn't show "n/a, n/a"). Never committed —
# regenerated per build.
ppxai/_build_info.py

# Corporate CA certs baked into coder-server image (operator-side state)
deploy/images/server/extra-certs/*.crt

# Codex (parallel-session) scratch/tooling — not part of the repo
.codex/

# .local is only for the local files not to be shared in git
**/.local
