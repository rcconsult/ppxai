/* ppxaide Layout CSS
 * This file defines layout and structure only.
 * Colors come from Textual's theme system ($primary, $surface, etc.)
 */

/* App-wide styles */
Screen {
    background: $background;
}

Header {
    background: $surface;
    color: $primary;
}

Footer {
    background: $surface;
    color: $text-muted;
}

/* Status bar */
StatusBar {
    background: $surface;
    color: $text;
    height: 1;
    padding: 0 1;
    dock: top;
}

StatusBar Horizontal {
    height: 1;
}

StatusBar .provider-badge {
    color: $success;
}

StatusBar .model-badge {
    color: $primary;
}

StatusBar .tools-badge {
    color: $warning;
}

StatusBar .context-badge {
    color: $accent;
}

/* Chat view */
ChatView {
    background: $background;
    padding: 1;
    height: 1fr;
}

/* Messages - using round borders for modern look */
MessageBox {
    padding: 1;
    margin-bottom: 1;
    background: $surface;
    width: 100%;
    border: round $surface-lighten-1;
}

MessageBox.user {
    background: $primary-darken-3;
    border: round $primary;
}

MessageBox.assistant {
    background: $surface;
    border: round $success;
}

MessageBox.system {
    background: $surface-darken-1;
    border: round $warning;
}

MessageBox.tool {
    background: $surface-darken-2;
    border: round $accent;
}

MessageBox .role-label {
    color: $text-muted;
    text-style: bold;
    margin-bottom: 1;
}

MessageBox .content {
    color: $text;
}

MessageBox.streaming .content {
    color: $text-muted;
}

/* Input box */
InputBox {
    background: $surface;
    border: round $primary;
    padding: 1;
    dock: bottom;
    height: auto;
    min-height: 3;
    max-height: 10;
    margin: 0 1 1 1;
}

InputBox Horizontal {
    height: auto;
}

InputBox Input {
    background: $background;
    color: $text;
    border: none;
    width: 1fr;
}

InputBox Input:focus {
    border: round $primary;
}

InputBox .prompt {
    width: auto;
    padding-right: 1;
    color: $primary;
}

/* Scrollbars */
VerticalScroll > ScrollBar {
    background: $surface;
}

VerticalScroll > ScrollBar > .scroll-bar--bar {
    background: $panel;
}

VerticalScroll > ScrollBar > .scroll-bar--bar:hover {
    background: $primary;
}

/* Status badge */
StatusBadge {
    padding: 0 1;
    margin: 0 1;
}

/* TreeViewer widget for JSON/YAML/TOML */
TreeViewer {
    background: $surface;
    border: round $accent;
    padding: 1;
    height: auto;
    min-height: 5;
    max-height: 20;
}

TreeViewer Tree {
    background: $surface;
    scrollbar-background: $surface;
    scrollbar-color: $panel;
    scrollbar-color-hover: $primary;
}

/* CodeEditor widget wrapping TextArea */
CodeEditor {
    background: $surface;
    border: round $primary;
    padding: 0;
    height: auto;
    min-height: 10;
}

CodeEditor TextArea {
    background: $background;
}

CodeEditor .editor-header {
    background: $panel;
    color: $text;
    height: 1;
    padding: 0 1;
}

CodeEditor .editor-footer {
    background: $panel;
    color: $text-muted;
    height: 1;
    padding: 0 1;
}

/* SplitPane layouts */
SplitPane {
    background: $background;
}

SplitPane.-horizontal {
    layout: horizontal;
}

SplitPane.-vertical {
    layout: vertical;
}

SplitPane .pane {
    border: round $surface-lighten-1;
    background: $surface;
    padding: 1;
}

SplitPane .pane:focus-within {
    border: round $primary;
}
