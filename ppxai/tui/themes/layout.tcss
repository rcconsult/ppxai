/* ppxaide Layout CSS
 * This file defines layout and structure only.
 * Colors come from Textual's theme system ($primary, $surface, etc.)
 */

/* App-wide styles */
Screen {
    background: $background;
}

Header {
    background: $primary-darken-3;
    color: $primary-lighten-2;
}

Footer {
    background: $surface-darken-1;
    color: $text-muted;
}

/* Status bar - distinct color from main content */
StatusBar {
    background: $surface-darken-1;
    color: $text;
    height: 1;
    padding: 0 1;
    dock: top;
}

StatusBar Horizontal {
    width: 1fr;
    height: 1;
    layout: horizontal;
    align: left top;
}

StatusBar .provider-badge {
    color: $success;
}

StatusBar .model-badge {
    color: $primary;
}

StatusBar .tools-badge {
    color: $warning;
}

StatusBar .context-badge {
    color: $accent;
}

/* Main content - horizontal split */
#main-content {
    height: 1fr;
    width: 100%;
}

/* File tree (leftmost pane, Norton Commander style) */
FileTree {
    width: 25%;
    height: 100%;
    border-right: solid $surface-lighten-1;
    background: $surface;
}

FileTree.hidden {
    display: none;
}

/* Root label acts as header showing truncated cwd */
FileTree > .tree--guides {
    background: $surface;
    scrollbar-background: $surface;
    scrollbar-color: $panel;
    scrollbar-color-hover: $primary;
}

/* Chat pane (fills remaining space after file tree and side panel) */
#chat-pane {
    width: 1fr;
    height: 100%;
}

/* Chat view */
ChatView {
    background: $background;
    padding: 0 1;
    height: 1fr;
}

/* Messages - using round borders for modern look */
MessageBox {
    padding: 0;
    margin-bottom: 0;
    background: $surface;
    width: 100%;
    height: auto;
    border: round $surface-lighten-1;
}

/* Ensure all MessageBox internal containers auto-size */
MessageBox Vertical {
    height: auto;
}

MessageBox.user {
    background: $background;
    border: round $primary;
    padding: 0 1;
}

MessageBox.assistant {
    background: $surface;
    border: round $success;
    padding: 0 1;
}

MessageBox.system {
    background: $background;
    border: round $warning;
    padding: 0 1;
}

MessageBox.tool {
    background: $surface-darken-2;
    border: round $accent;
}

MessageBox .role-label {
    color: $text-muted;
    text-style: bold;
    height: 1;
    width: auto;
    margin-bottom: 0;
}

MessageBox .content {
    color: $text;
    height: auto;
}

/* Scrollable container for tool output */
MessageBox.tool .content-scroll {
    height: auto;
    max-height: 20;
    border: none;
    padding: 0;
}

MessageBox.streaming .content {
    color: $text;
}

/* v1.15.0: Message header */
MessageBox .message-header {
    height: 1;
    width: 100%;
    layout: horizontal;
}

/* v1.15.1: Message footer with copy button (matches VSCode layout) */
MessageBox .message-footer {
    height: 1;
    width: 100%;
    layout: horizontal;
    margin: 1 0 0 0;
    align: right middle;
}

MessageBox .footer-spacer {
    width: 1fr;
    height: 1;
}

MessageBox .copy-btn {
    width: 8;
    min-width: 8;
    height: 1;
    padding: 0 1;
    border: none;
    background: $surface-lighten-1;
    color: $text-muted;
}

MessageBox .copy-btn:hover {
    background: $surface-lighten-2;
    color: $text;
}

MessageBox .copy-btn.copied {
    color: $success;
    background: $success-darken-2;
}

MessageBox .copy-btn.failed {
    color: $error;
    background: $error-darken-3;
}

/* Markdown rendering in chat messages */
MessageBox Markdown {
    padding: 0;
    background: transparent;
    height: auto;
}

MessageBox Markdown H1 {
    color: $primary;
    text-style: bold;
    margin: 0 0 1 0;
}

MessageBox Markdown H2 {
    color: $secondary;
    text-style: bold;
    margin: 0 0 1 0;
}

MessageBox Markdown H3, MessageBox Markdown H4 {
    color: $accent;
    text-style: bold;
}

MessageBox Markdown MarkdownFence {
    background: $surface-darken-1;
    border: round $primary;
    margin: 1 0;
    padding: 0 1;
}

MessageBox Markdown MarkdownBlockQuote {
    background: $surface-darken-1;
    border-left: thick $accent;
    padding-left: 1;
    margin: 1 0;
}

/* Links in markdown (clickable URLs) */
MessageBox Markdown .link {
    color: $accent;
    text-style: underline;
}

MessageBox Markdown MarkdownBulletList, MessageBox Markdown MarkdownOrderedList {
    margin: 0 0 0 2;
}

MessageBox Markdown MarkdownTable {
    margin: 1 0;
}

/* Input box */
InputBox {
    background: $surface;
    border: round $primary;
    padding: 0 1;
    dock: bottom;
    height: auto;
    min-height: 3;
    max-height: 20;  /* Increased to allow more lines */
    margin: 0 1 0 1;
}

/* Taller input when split view is active */
InputBox.split-mode {
    min-height: 5;
}

InputBox Horizontal {
    height: auto;
    align: left top;  /* Align prompt to top for multi-line */
}

InputBox TextArea {
    background: $background;
    color: $text;
    border: none;
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 18;
    scrollbar-size-vertical: 1;
}

InputBox TextArea:focus {
    border: round $primary;
}

InputBox .prompt {
    width: auto;
    padding-right: 1;
    padding-top: 0;  /* Align with top of multi-line input */
    color: $primary;
}

/* Scrollbars */
VerticalScroll > ScrollBar {
    background: $surface;
}

VerticalScroll > ScrollBar > .scroll-bar--bar {
    background: $panel;
}

VerticalScroll > ScrollBar > .scroll-bar--bar:hover {
    background: $primary;
}

/* Status badge */
StatusBadge {
    width: auto;
    height: 1;
    margin-right: 2;
}

/* TreeViewer widget for JSON/YAML/TOML */
TreeViewer {
    background: $surface;
    border: round $accent;
    padding: 1;
    height: auto;
    min-height: 5;
    max-height: 20;
}

TreeViewer Tree {
    background: $surface;
    scrollbar-background: $surface;
    scrollbar-color: $panel;
    scrollbar-color-hover: $primary;
}

/* CodeEditor widget wrapping TextArea */
CodeEditor {
    background: $surface;
    border: round $primary;
    padding: 0;
    height: auto;
    min-height: 10;
    layout: vertical;
}

CodeEditor TextArea {
    height: 1fr;
    /* Don't override background - let TextArea's syntax theme handle colors */
}

CodeEditor .editor-header {
    background: $panel;
    color: $text;
    height: 1;
    padding: 0 1;
    dock: top;
}

CodeEditor .editor-footer {
    background: $panel;
    color: $text-muted;
    height: 1;
    padding: 0 1;
    dock: bottom;
}

/* SplitPane layouts */
SplitPane {
    background: $background;
}

SplitPane.-horizontal {
    layout: horizontal;
}

SplitPane.-vertical {
    layout: vertical;
}

SplitPane .pane {
    border: round $surface-lighten-1;
    background: $surface;
    padding: 1;
}

SplitPane .pane:focus-within {
    border: round $primary;
}

/* ViewerScreen and EditorScreen */
ViewerScreen, EditorScreen {
    background: $background;
}

#viewer-header, #editor-title {
    background: $panel;
    color: $text;
    height: 1;
    padding: 0 1;
    dock: top;
}

#viewer-content, #editor-area {
    height: 1fr;
    border: none;
}

/* Full-screen TreeViewer in ViewerScreen */
ViewerScreen TreeViewer {
    height: 1fr;
    border: none;
}

/* Full-screen CodeEditor */
ViewerScreen CodeEditor, EditorScreen CodeEditor {
    height: 1fr;
    border: none;
}

/* Markdown viewer */
ViewerScreen VerticalScroll {
    height: 1fr;
    background: $background;
}

ViewerScreen Markdown {
    padding: 1 2;
    background: $background;
}

/* Markdown element styling */
ViewerScreen Markdown H1 {
    color: $primary;
    text-style: bold;
}

ViewerScreen Markdown H2 {
    color: $secondary;
    text-style: bold;
}

ViewerScreen Markdown H3, ViewerScreen Markdown H4 {
    color: $accent;
    text-style: bold;
}

ViewerScreen Markdown MarkdownFence {
    background: $surface;
    border: round $primary;
    margin: 1 0;
}

/* Side panel (right split) */
SidePanel {
    width: 50%;
    height: 100%;
    display: none;
    border-left: solid $surface-lighten-1;
}

SidePanel.visible {
    display: block;
}

SidePanel #panel-header-bar {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
    dock: top;
}

SidePanel #panel-filename {
    width: 1fr;
}

SidePanel #lang-badge {
    width: auto;
    color: $accent;
    padding: 0 1;
}

SidePanel #panel-content {
    height: 1fr;
    background: $background;
}

SidePanel CodeEditor {
    height: 1fr;
    border: none;
}

SidePanel TreeViewer {
    height: 1fr;
    border: none;
}

SidePanel VerticalScroll {
    height: 1fr;
    background: $background;
}

SidePanel Markdown {
    padding: 1 2;
    background: $background;
}

/* Markdown element styling for SidePanel */
SidePanel Markdown H1 {
    color: $primary;
    text-style: bold;
}

SidePanel Markdown H2 {
    color: $secondary;
    text-style: bold;
}

SidePanel Markdown H3, SidePanel Markdown H4 {
    color: $accent;
    text-style: bold;
}

SidePanel Markdown MarkdownFence {
    background: $surface;
    border: round $primary;
    margin: 1 0;
}

/* Image info panel */
SidePanel #panel-image-center {
    height: 1fr;
    align: center middle;
}

SidePanel #panel-image-info {
    padding: 2;
    text-align: center;
}

/* DataViewer widget for structured data */
DataViewer {
    background: $surface;
    height: 1fr;
    layout: vertical;
}

DataViewer .data-viewer-header {
    background: $panel;
    color: $text;
    height: 1;
    padding: 0 1;
    dock: top;
}

DataViewer #data-content-switcher {
    height: 1fr;
}

DataViewer #tree-view {
    height: 1fr;
}

DataViewer #source-view {
    height: 1fr;
}

DataViewer TreeViewer {
    height: 1fr;
    border: none;
}

DataViewer CodeEditor {
    height: 1fr;
    border: none;
}

/* DataViewer in SidePanel */
SidePanel DataViewer {
    height: 1fr;
    border: none;
}

/* ImageViewer widget for image display */
ImageViewer {
    background: $surface;
    height: 1fr;
    layout: vertical;
}

ImageViewer .image-viewer-header {
    background: $panel;
    color: $text;
    height: 1;
    padding: 0 1;
    dock: top;
}

ImageViewer .image-viewer-footer {
    background: $panel;
    color: $text-muted;
    height: 1;
    padding: 0 1;
    dock: bottom;
}

ImageViewer #image-center {
    height: 1fr;
    align: center middle;
}

ImageViewer #image-info-container {
    width: auto;
    height: auto;
    padding: 2;
}

ImageViewer #image-info {
    text-align: center;
}

/* textual-image Image widget inside ImageViewer */
ImageViewer Image {
    width: 100%;
    height: auto;
    max-width: 100%;
}

/* ImageViewer in SidePanel */
SidePanel ImageViewer {
    height: 1fr;
    border: none;
}

SidePanel ImageViewer Image {
    width: 100%;
    height: auto;
    max-width: 100%;
}

/* iTerm2 image widget (for WezTerm) */
ImageViewer ITerm2ImageWidget {
    width: auto;
    height: auto;
    content-align: center middle;
}

SidePanel ImageViewer ITerm2ImageWidget {
    width: auto;
    height: auto;
    content-align: center middle;
}

/* TableViewer widget for tabular data (CSV/TSV) */
TableViewer {
    background: $surface;
    height: 1fr;
    layout: vertical;
}

TableViewer .table-viewer-header {
    background: $panel;
    color: $text;
    height: 1;
    padding: 0 1;
    dock: top;
}

TableViewer #table-content-switcher {
    height: 1fr;
}

TableViewer #table-view {
    height: 1fr;
}

TableViewer #source-view {
    height: 1fr;
}

TableViewer DataTable {
    height: 1fr;
    border: none;
}

TableViewer CodeEditor {
    height: 1fr;
    border: none;
}

/* TableViewer in SidePanel */
SidePanel TableViewer {
    height: 1fr;
    border: none;
}

/* Confirmation dialog */
#confirm-dialog {
    width: 50%;
    height: auto;
    background: $surface;
    border: round $warning;
    padding: 2;
}

ConfirmCloseScreen {
    align: center middle;
    background: $background 80%;
}

/* Footer Status - Streaming indicators at bottom */
FooterStatus {
    height: 1;
    background: $surface-darken-1;
    color: $warning;
    padding: 0 1;
}

FooterStatus Horizontal {
    width: 1fr;
    height: 1;
    layout: horizontal;
    display: block;  /* Always visible layout */
}

FooterStatus #footer-status-text {
    width: 1fr;
    height: 1;
    text-style: bold;
    content-align: left middle;
}

FooterStatus #footer-status-timer {
    width: auto;
    height: 1;
    color: $accent;
    text-style: bold;
    content-align: right middle;
}
