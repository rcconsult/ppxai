        'ppxai.engine',
        'ppxai.engine.client',
        'ppxai.engine.session',
        'ppxai.engine.types',
        'ppxai.engine.providers',
        'ppxai.engine.providers.base',
        'ppxai.engine.providers.perplexity',
        'ppxai.engine.providers.openai_compat',
