# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly mark file types as text
*.py text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.spec text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.env* text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary files
*.png binary
*.ico binary
*.icns binary
*.exe binary
*.vsix binary
*.dmg binary
*.zip binary
