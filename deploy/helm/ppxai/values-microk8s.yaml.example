# MicroK8s corporate deployment — full overrides
# Copy to values-microk8s.yaml and fill in real values.
#
# Usage:
#   cp values-microk8s.yaml.example values-microk8s.yaml
#   # Edit with real IPs, hostnames, LDAP details
#   helm upgrade --install coder . -f values-microk8s.yaml -n coder
#
# API keys (never commit real values):
#   helm upgrade --install coder . -f values-microk8s.yaml \
#     --set apiKeys.keys.VLLM_API_KEY=your-real-key

namespace: coder
appPrefix: coder

namespaceLabels:
  environment: development

# --- Authentication (LDAP) ---
auth:
  mode: ldap
  ldap:
    url: "ldaps://your-dc.example.com:636"
    baseDn: "dc=example,dc=com"
    bindDn: "CN=svc-ldap-bind,OU=Service,DC=example,DC=com"
    existingSecret: "your-ldap-secret"
    existingSecretKey: "bindPassword"
    userFilter: "(objectClass=person)"
    usernameAttr: "sAMAccountName"
    cacheTtl: "300"

# --- External registry (microk8s addon) ---
registry:
  external: true
  externalHost: "registry.container-registry.svc.cluster.local"
  externalPort: 5000
  # kubelet uses NodePort, not in-cluster DNS
  pullHost: "localhost:32000"

# --- TLS ingress ---
ingress:
  host: coder.example.com
  className: nginx
  annotations:
    kubernetes.io/ingress.class: nginx
  tls:
    enabled: true
    secretName: your-tls-secret

# --- Use pre-existing StorageClasses ---
storageClass:
  create: false
  workspaceName: your-hostpath-retain
  ephemeralName: your-hostpath-delete

# --- Storage ---
storage:
  workspaceSize: 10Gi
  tempSize: 2Gi
  registryStorageClass: your-hostpath-retain
  registrySize: 5Gi
  staticPv:
    enabled: true
    hostPath: /path/to/pvc/coder/registry
    size: 5Gi
    storageClassName: your-hostpath-retain

# --- Sessions ---
session:
  maxSessions: 10
  ttlMinutes: 60

# --- Images ---
image:
  tag: latest
  pullPolicy: Always

# --- Kaniko ---
kaniko:
  sourcePath: /path/to/ppxai

# --- Resource limits ---
resources:
  enabled: true
  sessionManager:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 256Mi
  login:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 64Mi

# --- Monitoring ---
monitoring:
  enabled: true

# --- API keys ---
apiKeys:
  create: true
  keys:
    VLLM_API_KEY: "dummy"

# --- Login branding ---
login:
  title: "coder"
  logo: "coder"
  tagline: "AI-powered coding assistant"

# --- Server config (full ppxai-config.json) ---
serverConfig:
  version: "1.3"
  default_provider: "vllm-gptoss"
  system_prompt: "You are an expert AI coding assistant. Be concise and precise."
  system_prompt_mode: "prepend"
  server:
    idle_timeout: 0
    port: 54320
    working_dir: "/workspace"
    auto_enable_tools: true
    auto_enable_agent: true
  session:
    auto_restore: "never"
  bootstrap:
    files: ["AGENTS.md", "CLAUDE.md", "INSTRUCTIONS.md"]
    enabled: true
  providers:
    vllm-gptoss:
      name: "vLLM GPT-OSS 120B"
      base_url: "http://your-vllm-endpoint.local/v1"
      api_key_env: "VLLM_API_KEY"
      default_model: "openai/gpt-oss-120b"
      coding_model: "openai/gpt-oss-120b"
      system_prompt: "You are a helpful AI coding assistant. Be concise and direct.\n\nCRITICAL TOOL RULES:\n1. NEVER say 'I'll use the X tool' and then output JSON - just call the tool directly\n2. Do NOT output tool calls as JSON in your response - use native tool calling\n3. If you need a tool, call it immediately without explanation\n4. Only explain AFTER the tool returns its result"
      generation_params:
        temperature: 0.2
        top_p: 0.9
        frequency_penalty: 0.1
        presence_penalty: 0.05
      tool_calling:
        mode: "native"
        fallback_on_empty: true
        strip_json_from_text: true
      models:
        openai/gpt-oss-120b:
          name: "GPT-OSS 120B"
          description: "In-cluster vLLM with LMCache, native tool calling"
          context_limit: 131072
          max_tokens: 8192
          generation_params:
            temperature: 0.2
            top_p: 0.9
            frequency_penalty: 0.1
            presence_penalty: 0.05
          tool_calling:
            fallback_on_failure: true
      capabilities:
        web_search: true
        web_fetch: true
        weather: true
        realtime_info: true
        native_tool_calling: true
    dgx-spark:
      name: "DGX Spark vLLM (GB10)"
      base_url: "http://your-dgx-endpoint:8000/v1"
      api_key_env: "VLLM_API_KEY"
      default_model: "Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8"
      coding_model: "Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8"
      system_prompt: "You are an expert coding assistant. Be concise and precise."
      generation_params:
        temperature: 0.2
        top_p: 0.9
        frequency_penalty: 0.0
      tool_calling:
        mode: "native"
        fallback_on_empty: true
        strip_json_from_text: true
      models:
        Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8:
          name: "Qwen3 Coder 30B-A3B FP8 (MoE)"
          description: "Code-specialized MoE, native tool calling"
          context_limit: 131072
          max_tokens: 8192
      capabilities:
        web_search: true
        web_fetch: true
        weather: true
        realtime_info: true
        native_tool_calling: true
  tools:
    shell:
      timeout: 300
      require_consent: true
    agent:
      max_iterations: 25
      max_tool_iterations: 25
      checkpoint_backend: "none"
