# coder API keys — vLLM (in-cluster, dummy by default) + per-provider
# bearer tokens. ppxai-server pods get the WHOLE Secret via
# session-manager `envFrom`, so every key here becomes an env var
# inside the spawned pod. Provider entries in
# coder-server-config.yaml reference these via `api_key_env`.
#
# Create directly:
#   microk8s kubectl create secret generic coder-api-keys -n coder \
#     --from-literal=VLLM_API_KEY=dummy \
#     --from-literal=DGX_CLUSTER_API_KEY=<bearer-from-dgx-cluster.internal.example>
#
# Add a new key without touching the others:
#   microk8s kubectl patch secret coder-api-keys -n coder --type=json \
#     -p='[{"op":"add","path":"/data/NEW_KEY",
#           "value":"'"$(printf %s "$NEW_VALUE" | base64 -w0)"'"}]'
---
apiVersion: v1
kind: Secret
metadata:
  name: coder-api-keys
  namespace: coder
  labels:
    app.kubernetes.io/name: coder
    app.kubernetes.io/component: api-keys
type: Opaque
stringData:
  # Shared bearer for the older in-cluster vLLM deployments
  # (vllm-qwen35, vllm-qwen36, dgx-spark).
  VLLM_API_KEY: "dummy"
  # Per-provider bearer for the clustered DGX deployment exposed at
  # https://dgx-cluster.internal.example/vllm. Referenced from server-config
  # provider `dgx-cluster.api_key_env`. Populate with the real bearer
  # before applying — `dummy` here is a placeholder so a fresh apply
  # doesn't fail validation.
  DGX_CLUSTER_API_KEY: "dummy"
---
# Session signing key (C1) — HMAC key for the per-user auth cookie. The
# session-manager reads SESSION_SIGNING_KEY from this secret and refuses to
# start without it. MUST be persistent + stable across restarts (rotating it
# logs out all active users). Generate ONCE:
#
#   microk8s kubectl create secret generic coder-session-signing -n coder \
#     --from-literal=SESSION_SIGNING_KEY="$(openssl rand -hex 32)"
#
apiVersion: v1
kind: Secret
metadata:
  name: coder-session-signing
  namespace: coder
  labels:
    app.kubernetes.io/name: coder
    app.kubernetes.io/component: session-signing
type: Opaque
stringData:
  # REPLACE with `openssl rand -hex 32` output (>=32 bytes). The placeholder
  # below is exactly 64 hex chars so a fresh apply doesn't crash-loop, but it
  # is PUBLIC — rotate to a real random value before exposing the service.
  SESSION_SIGNING_KEY: "REPLACE_ME_WITH_openssl_rand_hex_32_0000000000000000000000"
# ---------------------------------------------------------------------------
# Secrets synced automatically by Reflector (DO NOT create manually):
#
#   your-tls-secret          — TLS wildcard cert, source: default namespace
#                            (already annotated, auto-syncs to all namespaces)
#
#   ldap-bind-secret  — LDAP bind password, source: openwebui namespace
#                            Annotate source to include coder namespace:
#
#     microk8s kubectl annotate secret ldap-bind-secret -n openwebui \
#       reflector.v1.k8s.emberstack.com/reflection-allowed="true" \
#       reflector.v1.k8s.emberstack.com/reflection-auto-enabled="true" \
#       reflector.v1.k8s.emberstack.com/reflection-auto-namespaces="brandev,sophia-trino,coder" \
#       --overwrite
# ---------------------------------------------------------------------------
