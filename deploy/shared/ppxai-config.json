{
  "version": "1.3",
  "default_provider": "custom",
  "system_prompt": "You are an expert AI coding assistant. Be concise and precise. When using tools, execute them directly and report results briefly. Focus on code quality, correctness, and best practices.",
  "system_prompt_mode": "prepend",
  "server": {
    "idle_timeout": 7200,
    "port": 54320
  },
  "session": {
    "auto_restore": "prompt",
    "auto_save_interval": 1
  },
  "context": {
    "max_injection_size": 100000,
    "default_context_limit": 128000,
    "warn_at_percent": 80
  },
  "bootstrap": {
    "files": ["AGENTS.md", "CLAUDE.md", "INSTRUCTIONS.md"],
    "enabled": true
  },
  "paths": {
    "bin_search_paths": [
      "{home}/.ppxai/bin",
      "{home}/.local/bin"
    ],
    "data_dir": "{home}/.ppxai"
  },
  "providers": {
    "custom": {
      "name": "Internal Code AI (GPT-OSS)",
      "base_url": "https://codeai.trad.int/v1",
      "api_key_env": "CUSTOM_API_KEY",
      "default_model": "openai/gpt-oss-120b",
      "coding_model": "openai/gpt-oss-120b",
      "system_prompt": "You are a helpful AI coding assistant. Be concise and direct.\n\nCRITICAL TOOL RULES:\n1. NEVER say 'I'll use the X tool' and then output JSON - just call the tool directly\n2. Do NOT output tool calls as JSON in your response - use native tool calling\n3. If you need a tool, call it immediately without explanation\n4. Only explain AFTER the tool returns its result\n5. After display_file: confirm 'File opened: <filename>'\n6. For pip/npm: warn 'May take time (timeout: 120s)'\n7. Prefer read_file over cat/type commands\n8. Use replace_block/insert_text/apply_patch for editing\n\nOn Windows: Use PowerShell syntax. Bash heredocs (<<EOF) and $() don't work.",
      "generation_params": {
        "temperature": 0.2,
        "top_p": 0.9,
        "frequency_penalty": 0.1,
        "presence_penalty": 0.05
      },
      "tool_calling": {
        "mode": "native",
        "fallback_on_empty": true,
        "strip_json_from_text": true
      },
      "models": {
        "openai/gpt-oss-120b": {
          "name": "GPT OSS 120B",
          "description": "Internal self-hosted GPT model with native tool calling via vLLM",
          "context_limit": 131072,
          "max_tokens": 8192,
          "generation_params": {
            "temperature": 0.2,
            "top_p": 0.9,
            "frequency_penalty": 0.1,
            "presence_penalty": 0.05
          },
          "tool_calling": {
            "fallback_on_failure": true
          }
        }
      },
      "pricing": {
        "openai/gpt-oss-120b": { "input": 0.0, "output": 0.0 }
      },
      "capabilities": {
        "web_search": true,
        "web_fetch": true,
        "weather": true,
        "realtime_info": true,
        "native_tool_calling": true
      }
    },
    "asusai-vllm": {
      "name": "DGX Spark vLLM (GB10)",
      "base_url": "http://llmprod.trad.int:8000/v1",
      "api_key_env": "OLLAMA_API_KEY",
      "default_model": "Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8",
      "coding_model": "Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8",
      "system_prompt": "You are an expert coding assistant running on a local NVIDIA GB10 GPU via vLLM. Be concise and precise. When using tools, execute them directly and report results briefly. Focus on code quality, correctness, and best practices.",
      "generation_params": {
        "temperature": 0.2,
        "top_p": 0.9,
        "frequency_penalty": 0.0
      },
      "tool_calling": {
        "mode": "native",
        "fallback_on_empty": true,
        "strip_json_from_text": true
      },
      "models": {
        "Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8": {
          "name": "Qwen3 Coder 30B-A3B FP8 (MoE)",
          "description": "Code-specialized MoE: 30.5B total / 3.3B active, FP8, native tool calling, 820K KV cache",
          "context_limit": 131072,
          "max_tokens": 8192
        },
        "Qwen/Qwen3-Coder-Next-FP8": {
          "name": "Qwen3-Coder-Next FP8 (Hybrid MoE)",
          "description": "Code-specialized hybrid MoE: 80B total / 3B active, FP8, Gated DeltaNet + MoE, 256K context",
          "context_limit": 131072,
          "max_tokens": 8192
        },
        "Qwen/Qwen3-Next-80B-A3B-Instruct-FP8": {
          "name": "Qwen3-Next 80B-A3B FP8 (Hybrid MoE)",
          "description": "Hybrid attention MoE: 80B total / 3.9B active, FP8, Gated DeltaNet + MoE, 262K context",
          "context_limit": 32768,
          "max_tokens": 8192
        },
        "RedHatAI/Qwen3-30B-A3B-FP8-dynamic": {
          "name": "Qwen3 30B-A3B FP8 (MoE)",
          "description": "RedHatAI FP8 quantized MoE: 30B total / 3B active, 99.9% accuracy recovery",
          "context_limit": 32768,
          "max_tokens": 8192
        },
        "Qwen/Qwen2.5-Coder-32B-Instruct": {
          "name": "Qwen2.5 Coder 32B (Dense)",
          "description": "Dense 32B coding model, proven benchmark results, all 32B active per token",
          "context_limit": 32768,
          "max_tokens": 8192
        }
      },
      "pricing": {
        "Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8": { "input": 0.0, "output": 0.0 },
        "Qwen/Qwen3-Coder-Next-FP8": { "input": 0.0, "output": 0.0 },
        "Qwen/Qwen3-Next-80B-A3B-Instruct-FP8": { "input": 0.0, "output": 0.0 },
        "RedHatAI/Qwen3-30B-A3B-FP8-dynamic": { "input": 0.0, "output": 0.0 },
        "Qwen/Qwen2.5-Coder-32B-Instruct": { "input": 0.0, "output": 0.0 }
      },
      "capabilities": {
        "web_search": true,
        "web_fetch": true,
        "weather": true,
        "realtime_info": true,
        "native_tool_calling": true
      }
    },
    "gemini": {
      "name": "Google Gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "api_key_env": "GEMINI_API_KEY",
      "default_model": "gemini-2.5-flash",
      "coding_model": "gemini-3-flash-preview",
      "generation_params": {
        "temperature": 0.3,
        "top_p": 0.9
      },
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash",
          "description": "Fast model, best price/performance",
          "context_limit": 1000000
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro",
          "description": "Complex reasoning",
          "context_limit": 1000000
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview",
          "description": "Speed-optimized preview with frontier intelligence",
          "context_limit": 1000000
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview",
          "description": "Advanced reasoning and agentic model",
          "context_limit": 1000000
        }
      },
      "pricing": {
        "gemini-2.5-flash": { "input": 0.30, "output": 2.50 },
        "gemini-2.5-pro": { "input": 1.25, "output": 10.0 },
        "gemini-3-flash-preview": { "input": 0.50, "output": 3.0 },
        "gemini-3.1-pro-preview": { "input": 2.0, "output": 12.0 }
      },
      "capabilities": {
        "web_search": true,
        "web_fetch": true,
        "native_tool_calling": true
      },
      "options": {
        "enable_grounding": true,
        "native_tool_calling": true
      }
    },
    "openai": {
      "name": "OpenAI",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "default_model": "gpt-5-mini",
      "coding_model": "gpt-5.1-codex",
      "generation_params": {
        "temperature": 0.3,
        "top_p": 0.95,
        "frequency_penalty": 0.1
      },
      "models": {
        "gpt-5.2": {
          "name": "GPT-5.2",
          "description": "Newest flagship with 400K context",
          "context_limit": 400000,
          "max_tokens": 16384
        },
        "gpt-5-mini": {
          "name": "GPT-5 Mini",
          "description": "Balanced performance at lower cost",
          "context_limit": 400000,
          "max_tokens": 16384
        },
        "gpt-5.1-codex": {
          "name": "GPT-5.1 Codex",
          "description": "Code-specialized model (Responses API)",
          "context_limit": 400000,
          "max_tokens": 16384
        },
        "gpt-4.1-mini": {
          "name": "GPT-4.1 Mini",
          "description": "Budget with 1M context",
          "context_limit": 1047576,
          "max_tokens": 32768
        },
        "o4-mini": {
          "name": "o4 Mini",
          "description": "Latest reasoning model",
          "context_limit": 200000,
          "max_tokens": 8192,
          "generation_params": { "temperature": 1.0 }
        }
      },
      "pricing": {
        "gpt-5.2": { "input": 1.75, "output": 14.0 },
        "gpt-5-mini": { "input": 0.25, "output": 2.0 },
        "gpt-5.1-codex": { "input": 1.25, "output": 10.0 },
        "gpt-4.1-mini": { "input": 0.4, "output": 1.6 },
        "o4-mini": { "input": 1.1, "output": 4.4 }
      },
      "capabilities": {
        "web_search": false,
        "web_fetch": false,
        "native_tool_calling": true
      }
    },
    "perplexity": {
      "name": "Perplexity AI",
      "base_url": "https://api.perplexity.ai",
      "api_key_env": "PERPLEXITY_API_KEY",
      "default_model": "sonar-pro",
      "coding_model": "sonar",
      "system_prompt": "You have two capabilities: (1) NATIVE WEB SEARCH for research, facts, and current information - use this automatically for questions and cite sources as markdown links. (2) EXTERNAL TOOLS for file operations, shell commands, and editing - when tools are available and the user asks to DO something (cd, ls, edit, fix, run, create, analyze), execute the appropriate tool immediately instead of explaining how. For actions: act first, report results briefly. For questions: search and cite. Never tell the user to do manually what a tool can do.",
      "generation_params": {
        "temperature": 0.2,
        "top_p": 0.9,
        "frequency_penalty": 0.15
      },
      "models": {
        "sonar": {
          "name": "Sonar",
          "description": "Lightweight search model with real-time grounding",
          "context_limit": 127072
        },
        "sonar-pro": {
          "name": "Sonar Pro",
          "description": "Advanced search model for complex queries",
          "context_limit": 200000
        },
        "sonar-reasoning-pro": {
          "name": "Sonar Reasoning Pro",
          "description": "Precision reasoning with Chain of Thought",
          "context_limit": 200000
        }
      },
      "pricing": {
        "sonar": { "input": 0.2, "output": 0.2 },
        "sonar-pro": { "input": 3.0, "output": 15.0 },
        "sonar-reasoning-pro": { "input": 5.0, "output": 15.0 }
      },
      "capabilities": {
        "web_search": true,
        "web_fetch": true,
        "weather": true,
        "realtime_info": true,
        "native_tool_calling": false
      }
    }
  },
  "tools": {
    "shell": {
      "timeout": 120,
      "require_consent": true,
      "dangerous_commands": [
        "^rm\\s+", "^del\\s+", "^rmdir\\s+", "^format\\s+", "^rd\\s+/s"
      ],
      "allowed_commands": [
        "^dir\\s+", "^type\\s+", "^echo\\s+", "^cd$", "^whoami$",
        "^ls\\s+", "^cat\\s+(?!.*[><])", "^grep\\s+", "^pwd$"
      ]
    },
    "agent": {
      "max_iterations": 25,
      "max_tool_iterations": 25,
      "context_char_limit": 4096,
      "min_task_words": 3,
      "checkpoint_backend": "auto",
      "max_same_tool_calls": 3
    },
    "web_search": {
      "preferred": "auto"
    }
  }
}
