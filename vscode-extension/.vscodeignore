.vscode/**
.vscode-test/**
.claude/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.ts
# Item 5 (v1.18.2): now bundled via esbuild — exclude everything
# except dist/, media/, resources/, and the user-facing docs. The
# bundle in dist/extension.js carries dotenv + all internal source.
# The webview-side libraries (marked, highlight.js) are loaded as
# static assets from media/webview/, not via node_modules.
node_modules/**
out/**
src/**
esbuild.js
build-hljs.cjs
# Build-time scripts run during prepackage (sync-schema), not at
# runtime — keep them out of the shipped VSIX.
scripts/**
# Dev-only documentation.
TESTING.md
