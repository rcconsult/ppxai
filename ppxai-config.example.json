{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.1",
  "default_provider": "perplexity",
  "comment": "Configuration for ppxai - customize providers, models, and autorouting behavior",
  "paths": {
    "__comment": "Binary and data paths (v1.13.2+). Use {home} for home directory",
    "__comment_windows": "On Windows, {home} expands to %USERPROFILE% (e.g., C:\\Users\\YourName)",
    "__comment_unix": "On Linux/macOS, {home} expands to $HOME (e.g., /home/username or /Users/username)",
    "bin_search_paths": [
      "{home}/.ppxai/bin",
      "{home}/AppData/Local/ppxai",
      "{home}/.local/bin",
      "{home}/bin",
      "/usr/local/bin"
    ],
    "__comment_bin_search_paths": "Directories to search for ppxai binaries (ppxai, ppxai-server, ppxai-desktop). Windows paths checked first.",
    "data_dir": "{home}/.ppxai",
    "__comment_data_dir": "Directory for sessions, exports, usage data, and config files"
  },
  "providers": {
    "perplexity": {
      "name": "Perplexity AI",
      "base_url": "https://api.perplexity.ai",
      "api_key_env": "PERPLEXITY_API_KEY",
      "default_model": "sonar-pro",
      "coding_model": "sonar-pro",
      "__comment_coding_model": "Model used for autorouting coding commands (/generate, /test, /convert, etc.)",
      "models": {
        "sonar": {
          "name": "Sonar",
          "description": "Lightweight search model with real-time grounding"
        },
        "sonar-pro": {
          "name": "Sonar Pro",
          "description": "Advanced search model for complex queries"
        },
        "sonar-reasoning-pro": {
          "name": "Sonar Reasoning Pro",
          "description": "Precision reasoning with Chain of Thought capabilities"
        },
        "sonar-deep-research": {
          "name": "Sonar Deep Research",
          "description": "Exhaustive research with comprehensive reports"
        }
      },
      "pricing": {
        "sonar": {"input": 0.20, "output": 0.20},
        "sonar-pro": {"input": 3.00, "output": 15.00},
        "sonar-reasoning-pro": {"input": 5.00, "output": 15.00},
        "sonar-deep-research": {"input": 5.00, "output": 15.00}
      },
      "capabilities": {
        "web_search": true,
        "web_fetch": true,
        "weather": true,
        "realtime_info": true
      }
    },
    "gemini": {
      "name": "Google Gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "api_key_env": "GEMINI_API_KEY",
      "default_model": "gemini-2.0-flash",
      "coding_model": "gemini-2.5-pro",
      "options": {
        "enable_grounding": true,
        "__comment_enable_grounding": "Enable Google Search Grounding for native web search (default: true)"
      },
      "models": {
        "gemini-2.0-flash": {
          "name": "Gemini 2.0 Flash",
          "description": "Fast model with multimodal support"
        },
        "gemini-2.0-flash-lite": {
          "name": "Gemini 2.0 Flash Lite",
          "description": "Cost-efficient for high-volume tasks"
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash",
          "description": "Latest fast model, best price/performance"
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro",
          "description": "Most capable model for complex reasoning"
        },
        "gemini-2.5-flash-lite": {
          "name": "Gemini 2.5 Flash Lite",
          "description": "For simple tasks that need to be done quickly"
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview",
          "description": "Speed-optimized preview with frontier intelligence and 1M context"
        },
        "gemini-3-pro-preview": {
          "name": "Gemini 3 Pro Preview",
          "description": "Most powerful agentic model with 1M context, code execution, and search grounding"
        }
      },
      "pricing": {
        "gemini-2.0-flash": {"input": 0.10, "output": 0.40},
        "gemini-2.0-flash-lite": {"input": 0.075, "output": 0.30},
        "gemini-2.5-flash": {"input": 0.15, "output": 0.60},
        "gemini-2.5-flash-lite": {"input": 0.075, "output": 0.30},
        "gemini-2.5-pro": {"input": 1.25, "output": 5.00},
        "gemini-3-flash-preview": {"input": 0.15, "output": 0.60},
        "gemini-3-pro-preview": {"input": 1.25, "output": 5.00}
      },
      "capabilities": {
        "web_search": true,
        "web_fetch": false,
        "weather": false,
        "realtime_info": false
      }
    },
    "openai": {
      "name": "OpenAI ChatGPT",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "default_model": "gpt-4o",
      "coding_model": "gpt-4o",
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "description": "Latest flagship model with vision"
        },
        "gpt-4o-mini": {
          "name": "GPT-4o Mini",
          "description": "Fast and affordable for simple tasks"
        },
        "gpt-4-turbo": {
          "name": "GPT-4 Turbo",
          "description": "Previous generation with 128K context"
        },
        "o1": {
          "name": "o1",
          "description": "Advanced reasoning model"
        },
        "o1-mini": {
          "name": "o1 Mini",
          "description": "Fast reasoning model"
        }
      },
      "pricing": {
        "gpt-4o": {"input": 2.50, "output": 10.00},
        "gpt-4o-mini": {"input": 0.15, "output": 0.60},
        "gpt-4-turbo": {"input": 10.00, "output": 30.00},
        "o1": {"input": 15.00, "output": 60.00},
        "o1-mini": {"input": 3.00, "output": 12.00}
      },
      "capabilities": {
        "web_search": false,
        "web_fetch": false,
        "weather": false,
        "realtime_info": false
      },
      "__comment_web_search_override": "v1.13.4: Optional per-provider override for premium web search",
      "web_search": {
        "__comment": "Override global tools.web_search.preferred for this provider only",
        "preferred": "gemini"
      }
    },
    "openrouter": {
      "name": "OpenRouter",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "default_model": "anthropic/claude-sonnet-4",
      "coding_model": "anthropic/claude-sonnet-4",
      "models": {
        "anthropic/claude-sonnet-4": {
          "name": "Claude Sonnet 4",
          "description": "Anthropic's balanced model for most tasks"
        },
        "anthropic/claude-opus-4": {
          "name": "Claude Opus 4",
          "description": "Anthropic's most capable model"
        },
        "anthropic/claude-haiku": {
          "name": "Claude Haiku",
          "description": "Fast and affordable Claude model"
        },
        "google/gemini-2.0-flash-001": {
          "name": "Gemini 2.0 Flash",
          "description": "Google's fast multimodal model"
        },
        "meta-llama/llama-3.1-405b-instruct": {
          "name": "Llama 3.1 405B",
          "description": "Meta's largest open model"
        }
      },
      "pricing": {
        "anthropic/claude-sonnet-4": {"input": 3.00, "output": 15.00},
        "anthropic/claude-opus-4": {"input": 15.00, "output": 75.00},
        "anthropic/claude-haiku": {"input": 0.25, "output": 1.25},
        "google/gemini-2.0-flash-001": {"input": 0.10, "output": 0.40},
        "meta-llama/llama-3.1-405b-instruct": {"input": 3.00, "output": 3.00}
      },
      "capabilities": {
        "web_search": false,
        "web_fetch": false,
        "weather": false,
        "realtime_info": false
      }
    },
    "local-vllm": {
      "name": "Local vLLM",
      "base_url": "http://localhost:8000/v1",
      "api_key_env": "LOCAL_API_KEY",
      "default_model": "meta-llama/Llama-3-70b",
      "coding_model": "meta-llama/Llama-3-70b",
      "models": {
        "meta-llama/Llama-3-70b": {
          "name": "Llama 3 70B",
          "description": "Self-hosted Llama 3 70B model"
        }
      },
      "pricing": {
        "meta-llama/Llama-3-70b": {"input": 0.0, "output": 0.0}
      },
      "capabilities": {
        "web_search": false,
        "web_fetch": false,
        "weather": false,
        "realtime_info": false,
        "native_tool_calling": false,
        "__comment_native_tool_calling": "Set true if vLLM started with --enable-auto-tool-choice"
      }
    },
    "vllm-gpt-oss": {
      "__comment": "Example vLLM config with native tool calling (requires --enable-auto-tool-choice)",
      "name": "GPT-OSS 120B (vLLM)",
      "base_url": "http://vllm-gpt-oss:8000/v1",
      "api_key_env": "VLLM_API_KEY",
      "default_model": "openai/gpt-oss-120b",
      "coding_model": "openai/gpt-oss-120b",
      "models": {
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B",
          "description": "GPT-OSS 120B model with native tool calling via vLLM"
        }
      },
      "pricing": {
        "openai/gpt-oss-120b": {"input": 0.0, "output": 0.0}
      },
      "capabilities": {
        "web_search": false,
        "web_fetch": false,
        "weather": false,
        "realtime_info": false,
        "native_tool_calling": true,
        "__comment": "Native tool calling enabled - vLLM started with --enable-auto-tool-choice --tool-call-parser seed_oss"
      }
    },
    "ollama": {
      "name": "Ollama Local",
      "base_url": "http://localhost:11434/v1",
      "api_key_env": "OLLAMA_API_KEY",
      "default_model": "llama3.2",
      "coding_model": "codellama",
      "models": {
        "llama3.2": {
          "name": "Llama 3.2",
          "description": "Latest Llama model via Ollama"
        },
        "codellama": {
          "name": "Code Llama",
          "description": "Specialized coding model"
        },
        "mistral": {
          "name": "Mistral 7B",
          "description": "Fast and efficient model"
        }
      },
      "pricing": {
        "llama3.2": {"input": 0.0, "output": 0.0},
        "codellama": {"input": 0.0, "output": 0.0},
        "mistral": {"input": 0.0, "output": 0.0}
      },
      "capabilities": {
        "web_search": false,
        "web_fetch": false,
        "weather": false,
        "realtime_info": false
      }
    }
  },
  "tools": {
    "shell": {
      "require_consent": true,
      "dangerous_commands": [
        "^rm\\s+",
        "^mv\\s+",
        "^dd\\s+",
        "^chmod\\s+",
        "^chown\\s+",
        "^sudo\\s+",
        "^curl.*\\|.*bash",
        "^wget.*\\|.*bash",
        ">\\s*/dev/",
        "^kill\\s+",
        "^pkill\\s+",
        "^killall\\s+"
      ],
      "allowed_commands": [
        "^ls\\s+",
        "^cat\\s+(?!.*[><])",
        "^grep\\s+",
        "^echo\\s+(?!.*>)",
        "^pwd$",
        "^which\\s+",
        "^whoami$",
        "^date$",
        "^uname\\s+"
      ],
      "never_allow": [
        "rm\\s+-rf\\s+/",
        "dd\\s+.*of=/dev/",
        ":\\(\\)\\{\\s*:\\|:\\&\\s*\\};:",
        "mkfs\\.",
        "^\\s*>\\s*/dev/sda"
      ],
      "sandboxed_paths": []
    },
    "agent": {
      "__comment": "Agent mode configuration (v1.11.9+, v1.12.0 checkpoint features)",
      "max_iterations": 10,
      "__comment_max_iterations": "Maximum number of agent loop iterations (outer loop: full conversation turns)",
      "max_tool_iterations": 15,
      "__comment_max_tool_iterations": "Maximum tool calls per conversation turn (inner loop: tool chain limit)",
      "context_char_limit": 2000,
      "__comment_context_char_limit": "Character limit for tool output display in verbose mode",
      "min_task_words": 3,
      "__comment_min_task_words": "Minimum words required for agent tasks (safety: reject vague tasks)",
      "checkpoint_backend": "auto",
      "__comment_checkpoint_backend": "Checkpoint backend: 'auto' (detect git), 'git' (git-only), 'file' (file snapshots), 'none' (disabled)",
      "checkpoint_message": "ppxai checkpoint: {task}",
      "__comment_checkpoint_message": "Git commit message template ({task} is replaced with task description)"
    },
    "web_search": {
      "__comment": "Premium web search configuration (v1.13.4+)",
      "preferred": "auto",
      "__comment_preferred": "Search provider: 'auto' (detect), 'perplexity', 'gemini', 'duckduckgo'",
      "perplexity_model": "sonar",
      "__comment_perplexity_model": "Model for Perplexity searches (sonar = cheapest)",
      "gemini_model": "gemini-2.0-flash",
      "__comment_gemini_model": "Model for Gemini grounding searches",
      "pricing": {
        "perplexity": {
          "input": 0.20,
          "output": 0.20,
          "model": "per_token",
          "__comment": "Perplexity Sonar pricing per 1M tokens"
        },
        "gemini_grounding": {
          "per_query": 14.00,
          "model": "per_query",
          "__comment": "Gemini 3 Google Search Grounding: $14/1000 queries"
        }
      }
    }
  }
}
